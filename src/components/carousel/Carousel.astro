---
import "./carousel.scss";

interface Props {
    slides: Array<{
        title: string;
        description: string;
        link?: string;
    }>;
    carouselId: string;
}

const {slides, carouselId} = Astro.props;

---

<div class="slider">
    <div class="slides">
        {slides.map(({title, description, link}, i) => () => (
                <div id={`slide-${carouselId}-${i}`}>
                    {description}
                </div>
        ))}
    </div>

    {slides.map((_, i) => (
            <a href={`#slide-${carouselId}-${i + 1}`}>{i + 1}</a>
    ))}

</div>
