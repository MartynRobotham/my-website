---
import "./carousel.scss";

interface Props {
    slides: Array<{
        title: string;
        dates?: string;
        description: string;
        link?: string;
    }>;
    carouselId: string;
}

const {slides, carouselId} = Astro.props;

---

<div class="slider">
    <div class="slides">
        {slides.map(({title, dates, description, link}, i) => () => (
                <div id={`slide-${carouselId}-${i + 1}`}>
                    <p>{title}{dates ? `: ${dates}` : ''}</p>
                    <p>{description}</p>
                    {link && <a href={link}>Find out more here</a>}
                </div>
        ))}
    </div>

    {slides.map((_, i) => (
            <a href={`#slide-${carouselId}-${i + 1}`}>{i + 1}</a>
    ))}

</div>
