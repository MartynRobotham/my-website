---
/// <reference types="vite-plugin-pwa/info" />
import { pwaInfo } from 'virtual:pwa-info';
import '../pwa.ts';
import Navigation from "../components/navigation/Navigation.astro"; // relative import — this will be bundled

import "@/styles/layout.scss";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="../../public/assets/favicon/favicon.ico" />

		<!--TODO: Isolate fonts to local instance-->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Alumni+Sans+Pinstripe&family=Gowun+Dodum&display=swap" rel="stylesheet">

		<meta name="generator" content={Astro.generator} />
		{pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
		<title>Martyn Robotham | Experienced Web Developer with front end specialisms</title>
	</head>
	<body>
	<section>
		<Navigation />
	</section>
		<slot />
	</body>
</html>
