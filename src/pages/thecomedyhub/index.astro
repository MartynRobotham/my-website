---
import "./index.scss";
import Layout from "../../layouts/Layout.astro";
---

<Layout>
    <section>
        <h1>Welcome to my comedy hub - a collection of videos of some recent performances</h1>

        <div class="video-grid">
            <div>
                <iframe width="100%" height="315" src="https://www.youtube.com/embed/PTA4TUzhksM?si=wR-TQuJL_uBiNIWs"
                        title="Ultra - 21st December 2025"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                <p>Ultra - 21st December 2025</p>
            </div>

            <div>
                <iframe width="100%" height="315" src="https://www.youtube.com/embed/JDy8HqO_kGs?si=18T2tbtxD1ZvnDBk"
                        title="Ultra - 21st December 2025 alternate"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                <p>Ultra - 21st December 2025 (Alternate)</p>
            </div>

            <div>
                <iframe width="100%" height="702" src="https://www.youtube.com/embed/g6bLpiatZ7M"
                        title="Lamb Comedy - 3rd February 2026"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                <p>Lamb Comedy Club - 4th February 2026</p>
            </div>

            <div>
                <iframe width="100%" height="702" src="https://www.youtube.com/embed/9W1eq3XLv5E"
                        title="Carlton Tavern - 11th March 2026"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                <p>Carlton Tavern - 11th March 2026</p>
            </div>

            <div>
                <a href="/audio/st-ives-corn-exchange.m4a" download>St Ives Corn Exchange (21st March) - Listen to the audio</a>
            </div>

            <div>
                <iframe width="100%" height="702" src="https://www.youtube.com/embed/Faqku80pjjs"
                        title="Carlton Tavern - 11th March 2026"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                <p>Lamb Comedy - 25th March 2026</p>
            </div>
        </div>
    </section>
</Layout>
